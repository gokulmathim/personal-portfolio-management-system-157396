---
import Layout from '../layouts/Layout.astro';

const title = 'Contact';
---

<Layout {title}>
  <section class="card">
    <div class="contact">
      <h1 class="section-title">Contact</h1>
      <p class="subtitle">Want to collaborate or have a question? Send a message.</p>

      <form id="contactForm" class="form">
        <div class="form-group">
          <label for="name">Name</label>
          <input class="form-control" id="name" name="name" placeholder="Your name" required />
        </div>
        <div class="form-group">
          <label for="email">Email</label>
          <input class="form-control" id="email" name="email" type="email" placeholder="you@example.com" required />
        </div>
        <div class="form-group">
          <label for="message">Message</label>
          <textarea class="form-control" id="message" name="message" rows="5" placeholder="How can I help?" required></textarea>
        </div>
        <button class="btn btn-primary" type="submit">Send</button>
        <span id="status" class="subtitle"></span>
      </form>
    </div>
  </section>
</Layout>

<style>
  .contact { padding: 18px; }
  #status { margin-left: 10px; }
</style>

<script type="module">
  import { sendContactMessage } from '../lib/api.ts';

  const form = document.getElementById('contactForm');
  const statusEl = document.getElementById('status');

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusEl.textContent = 'Sending...';
    const fd = new FormData(form);
    const payload = Object.fromEntries(fd.entries());
    try {
      await sendContactMessage({
        name: String(payload.name || ''),
        email: String(payload.email || ''),
        message: String(payload.message || ''),
      });
      statusEl.textContent = 'Message sent. Thank you!';
      form.reset();
    } catch (err) {
      statusEl.textContent = 'Failed to send: ' + (err?.message || 'Unknown error');
    }
  });
</script>

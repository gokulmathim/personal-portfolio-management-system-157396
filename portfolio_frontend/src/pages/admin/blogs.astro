---
import Layout from '../../layouts/Layout.astro';

const title = 'Manage Blogs';
---

<Layout {title}>
  <section class="card">
    <div class="admin">
      <div class="head">
        <h1 class="section-title">Blog Posts</h1>
        <div class="actions">
          <a class="btn" href="/admin">Dashboard</a>
          <a class="btn" href="/admin/projects">Projects</a>
        </div>
      </div>

      <form id="createForm" class="form">
        <h3>Create New Post</h3>
        <div class="grid-2">
          <div class="form-group">
            <label for="slug">Slug</label>
            <input class="form-control" id="slug" name="slug" placeholder="my-first-post" required />
          </div>
          <div class="form-group">
            <label for="title">Title</label>
            <input class="form-control" id="title" name="title" placeholder="Post title" required />
          </div>
        </div>
        <div class="form-group">
          <label for="excerpt">Excerpt</label>
          <textarea class="form-control" id="excerpt" name="excerpt" rows="2" placeholder="Short summary"></textarea>
        </div>
        <div class="form-group">
          <label for="content">Content (HTML allowed)</label>
          <textarea class="form-control" id="content" name="content" rows="8" placeholder="<p>Full content here...</p>"></textarea>
        </div>
        <div class="form-group">
          <label for="tags">Tags (comma-separated)</label>
          <input class="form-control" id="tags" name="tags" placeholder="astro, typescript, web" />
        </div>
        <button class="btn btn-primary" type="submit">Publish</button>
        <span id="status" class="subtitle"></span>
      </form>

      <hr class="sep"/>

      <h3>Existing Posts</h3>
      <div id="list" class="cards"></div>
    </div>
  </section>
</Layout>

<style>
  .admin { padding: 18px; }
  .head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .grid-2 { display: grid; grid-template-columns: 1fr; gap: 12px; }
  @media (min-width: 780px) { .grid-2 { grid-template-columns: 1fr 1fr; } }
  .cards { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; margin-top: 12px; }
  .card-item { grid-column: span 12; }
  @media (min-width: 980px) { .card-item { grid-column: span 6; } }
  .card-content { padding: 14px; }
  .meta { display: flex; gap: 10px; align-items: center; margin-top: 8px; flex-wrap: wrap; }
</style>

<script type="module">
  import { isAuthenticated } from '../../lib/auth.ts';
  import { getBlogPosts, createBlogPost, deleteBlogPost } from '../../lib/api.ts';

  if (!isAuthenticated()) {
    location.replace('/admin/login');
  }

  const form = document.getElementById('createForm');
  const statusEl = document.getElementById('status');
  const list = document.getElementById('list');

  function card(p) {
    const date = p.published_at ? new Date(p.published_at).toLocaleString() : '';
    return `
      <article class="card card-item">
        <div class="card-content">
          <h3>${p.title || 'Untitled'}</h3>
          <p class="subtitle">${p.excerpt || ''}</p>
          <div class="meta">
            <a class="btn btn-outline" href="/blog/${p.slug || p.id}" target="_blank" rel="noopener">View</a>
            <button class="btn btn-outline" data-del="${p.slug || p.id}">Delete</button>
            <span class="badge">${date}</span>
          </div>
        </div>
      </article>
    `;
  }

  async function refresh() {
    try {
      const posts = await getBlogPosts();
      list.innerHTML = (posts || []).map(card).join('') || '<p class="subtitle">No posts yet.</p>';
      list.querySelectorAll('button[data-del]').forEach((btn) => {
        btn.addEventListener('click', async () => {
          const id = btn.getAttribute('data-del');
          if (!id) return;
          btn.setAttribute('disabled', 'true');
          try {
            await deleteBlogPost(id);
            await refresh();
          } catch (e) {
            alert('Delete failed: ' + (e?.message || 'Unknown error'));
          } finally {
            btn.removeAttribute('disabled');
          }
        });
      });
    } catch (e) {
      list.innerHTML = `<p class="subtitle">Failed to load: ${e?.message || 'Unknown error'}</p>`;
    }
  }

  form?.addEventListener('submit', async (e) => {
    e.preventDefault();
    statusEl.textContent = 'Publishing...';
    const fd = new FormData(form);
    const data = Object.fromEntries(fd.entries());
    const payload = {
      slug: String(data.slug || ''),
      title: String(data.title || ''),
      excerpt: String(data.excerpt || ''),
      content: String(data.content || ''),
      tags: String(data.tags || '')
        .split(',')
        .map((s) => s.trim())
        .filter(Boolean),
    };
    try {
      await createBlogPost(payload);
      statusEl.textContent = 'Published!';
      form.reset();
      await refresh();
    } catch (e) {
      statusEl.textContent = 'Failed: ' + (e?.message || 'Unknown error');
    }
  });

  refresh();
</script>

---
import Layout from '../../layouts/Layout.astro';

const title = 'Admin Dashboard';
---

<Layout {title}>
  <section class="card">
    <div class="dash">
      <div class="dash-head">
        <h1 class="section-title">Dashboard</h1>
        <div class="actions">
          <a class="btn" href="/admin/projects">Manage Projects</a>
          <a class="btn" href="/admin/blogs">Manage Blogs</a>
          <button id="logoutBtn" class="btn btn-outline">Log out</button>
        </div>
      </div>

      <div class="stats">
        <div class="stat card"><div><span class="badge">Projects</span><h3 id="projectsCount">—</h3></div></div>
        <div class="stat card"><div><span class="badge">Blog Posts</span><h3 id="blogsCount">—</h3></div></div>
      </div>
    </div>
  </section>
</Layout>

<style>
  .dash { padding: 18px; }
  .dash-head { display: flex; align-items: center; justify-content: space-between; gap: 12px; flex-wrap: wrap; }
  .actions { display: flex; gap: 10px; flex-wrap: wrap; }
  .stats { display: grid; grid-template-columns: repeat(12, 1fr); gap: 14px; margin-top: 18px; }
  .stat { grid-column: span 12; padding: 14px; }
  .stat h3 { margin: 6px 0 0 0; font-size: 2rem; }
  @media (min-width: 720px) { .stat { grid-column: span 6; } }
</style>

<script type="module">
  import { isAuthenticated, clearToken } from '../../lib/auth.ts';
  import { getProjects, getBlogPosts } from '../../lib/api.ts';

  if (!isAuthenticated()) {
    location.replace('/admin/login');
  }

  const projectsCountEl = document.getElementById('projectsCount');
  const blogsCountEl = document.getElementById('blogsCount');
  const logoutBtn = document.getElementById('logoutBtn');

  logoutBtn?.addEventListener('click', () => {
    clearToken();
    location.replace('/admin/login');
  });

  async function load() {
    try {
      const [projects, blogs] = await Promise.all([getProjects(), getBlogPosts()]);
      projectsCountEl.textContent = String(projects?.length || 0);
      blogsCountEl.textContent = String(blogs?.length || 0);
    } catch (e) {
      projectsCountEl.textContent = '0';
      blogsCountEl.textContent = '0';
    }
  }
  load();
</script>
